generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int       @id @default(autoincrement)
  username  String    @unique
  password  String    // Hashed password for NextAuth credentials login
  createdAt DateTime  @default(now)
}

model User {
  id        Int       @id @default(autoincrement)
  name      String
  email     String    @unique
  bio       String?
  story     String?
  avatar    String?
  createdAt DateTime  @default(now)
}

model Education {
  id          Int      @id @default(autoincrement)
  degree      String
  institution String
  period      String
  description String?
  courses     String[]
  order       Int      @default(0)
}

model Project {
  id        Int       @id @default(autoincrement)
  title     String
  slug      String    @unique
  description String?
  fullDescription String?
  techStack String[]
  highlights String[]
  githubUrl String?
  demoUrl   String?
  imageUrl  String?
  category  String?
  isActive  Boolean   @default(true)
  isFeatured Boolean  @default(false)
  order     Int       @default(0)
  createdAt DateTime @default(now)
}

model Skill {
  id       Int   @id @default(autoincrement)
  name     String
  level    Int   
  category String 
}

model Experience {
  id          Int      @id @default(autoincrement)
  title       String
  company     String
  period      String
  description String?
  highlights  String[]
  order       Int      @default(0)
}

model BlogPost {
  id        Int       @id @default(autoincrement)
  title     String
  slug      String    @unique
  excerpt   String?
  content   String?   
  authorId  Int?      
  createdAt DateTime @default(now)
  published Boolean   @default(false)
  viewCount Int       @default(0)

  author User? @relation(fields: [authorId], references: [id])
}

model PageView {
  id        Int      @id @default(autoincrement)
  path      String   // the URL path visited
  referrer  String?  // where they came from
  userAgent String?  // browser info
  createdAt DateTime @default(now())
}

model Certification {
  id        Int      @id @default(autoincrement)
  title     String
  issuer    String?
  date      String?
  url       String?
  order     Int      @default(0)
}

model Language {
  id              Int      @id @default(autoincrement)
  title           String
  proficiency     String
  additionalInfo  String?
  extraDetails    String?
  highlights      String[]
  order           Int      @default(0)
}

model VolunteerWork {
  id              Int      @id @default(autoincrement)
  organization    String
  role            String
  date            String?
  additionalInfo  String?
  extraDetails    String?
  highlights      String[]
  order           Int      @default(0)
}

model ResumeSection {
  id        Int      @id @default(autoincrement)
  name      String   @unique
  title     String
  order     Int      @default(0)
  visible   Boolean  @default(true)
}