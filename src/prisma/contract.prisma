// use prisma-next

model Admin {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String    
  createdAt TimestamptzString @default(now())
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  bio       String?
  avatar    String?
  createdAt TimestamptzString @default(now())
}

model Project {
  id        Int       @id @default(autoincrement())
  title     String
  slug      String    @unique
  description String?
  techStack String[]
  githubUrl String?
  demoUrl   String?
  imageUrl  String?
  order     Int       @default(0)
  createdAt TimestamptzString @default(now())
}

model Skill {
  id       Int   @id @default(autoincrement())
  name     String
  level    Int   
  category String 
}

model Experience {
  id       Int   @id @default(autoincrement())
  title    String
  company  String
  period   String
  description String?
}

model BlogPost {
  id        Int       @id @default(autoincrement())
  title     String
  slug      String    @unique
  excerpt   String?
  content   String?   
  authorId  Int?      
  createdAt TimestamptzString @default(now())
  published Boolean   @default(false)
  viewCount Int       @default(0)

  author User? @relation(fields: [authorId], references: [id])
}
