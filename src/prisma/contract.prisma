// use prisma-next

model Admin {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String    
  createdAt TimestamptzString @default(now())
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  bio       String?
  story     String?
  avatar    String?
  createdAt TimestamptzString  @default(now())
}

model Education {
  id          Int      @id @default(autoincrement())
  degree      String
  institution String
  period      String
  description String?
  courses     String[] @default([])
  order       Int      @default(0)
}

model Project {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  description     String?
  fullDescription String?
  category        String?
  role            String?
  timeline        String?
  techStack       String[]  @default([])
  highlights      String[]  @default([])
  metrics         Json?
  githubUrls      String[]  @default([])
  demoUrl         String?
  imageUrl        String?
  order           Int       @default(0)
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  createdAt       TimestamptzString @default(now())
}

enum SkillCategory {
  Frontend
  Backend
  Mobile
  Database
  CloudDevOps
  DataAnalyticsML
  Languages
  Tools
}

model Skill {
  id         Int               @id @default(autoincrement())
  name       String
  level      Int   
  categories String[]          @default([])
}

model Experience {
  id          Int      @id @default(autoincrement())
  title       String
  company     String
  period      String
  description String?
  highlights  String[] @default([])
  order       Int      @default(0)
}

model BlogPost {
  id        Int       @id @default(autoincrement())
  title     String
  slug      String    @unique
  excerpt   String?
  content   String?   
  authorId  Int?      
  createdAt TimestamptzString @default(now())
  published Boolean   @default(false)
  viewCount Int       @default(0)

  author User? @relation(fields: [authorId], references: [id])
}

model PageView {
  id        Int      @id @default(autoincrement())
  path      String   // the URL path visited
  referrer  String?  // where they came from
  userAgent String?  // browser info
  createdAt TimestamptzString @default(now())
}

model Certification {
  id        Int      @id @default(autoincrement())
  title     String
  issuer    String?
  date      String?
  url       String?
  order     Int      @default(0)
}

model Language {
  id              Int      @id @default(autoincrement())
  title           String
  proficiency     String
  additionalInfo  String?
  extraDetails    String?
  highlights      String[] @default([])
  order           Int      @default(0)
}

model VolunteerWork {
  id              Int      @id @default(autoincrement())
  organization    String
  role            String
  date            String?
  additionalInfo  String?
  extraDetails    String?
  highlights      String[] @default([])
  order           Int      @default(0)
}

model ResumeSection {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  title     String
  order     Int      @default(0)
  visible   Boolean  @default(true)
}

model ResumeSettings {
  id              Int      @id @default(autoincrement())
  activeTemplate  String   @default("T1")
  activeTheme     String   @default("Black")
  activeLayout    String   @default("Standard")
}
